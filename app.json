{
  "expo": {
    "name": "CallNChat",
    "slug": "callnchat",
    "scheme": "callnchat",
    "version": "0.1.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "ios": {
      "bundleIdentifier": "com.frazghuman.callnchat",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your contact's pairing code. Video calls use the camera too.",
          "microphonePermission": "Voice and video calls with your contact.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock CallNChat with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
